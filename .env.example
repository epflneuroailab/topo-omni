# Topo-Omni (model side) environment.
# Copy to `.env` at the repo root (loaded via python-dotenv). Do NOT commit your `.env`.
#
# For the DEFAULT figure-reproduction path (precomputed) you do NOT need a GPU,
# stimuli, or a checkpoint — only SAVE_DIR (where the downloaded cut lands) is used.
# The other paths matter only for the `raw` recompute path and for training.

# --- Model -------------------------------------------------------------------
# HuggingFace id (or a local directory) of the trained topographic model.
# Default is the public release; override to evaluate a local checkpoint.
TOPO_OMNI_MODEL=epfl-neuroai/topo-omni

# --- Paths (raw / training only) ---------------------------------------------
# Root that holds (or will hold) per-figure model outputs / the precomputed cut.
SAVE_DIR=/path/to/results
# ON/OFF stimulus banks (marvi_videos_*, pernet_*, retinotopy/, tone_bank/, ...).
STIMULI_DIR=/path/to/stimuli
# Local checkpoint dir (only if not loading the model from HuggingFace).
CKPT_DIR=/path/to/checkpoints
# Repo root (used by a few analysis scripts to locate topo-discover artifacts).
REPO_DIR=/path/to/topo-omni-epfl
# Raw video training data (training only).
DATA_DIR=/path/to/video/data

# --- Secrets (optional) ------------------------------------------------------
# Only needed for training logging / gated or private HuggingFace access.
WANDB_API_KEY=
HF_TOKEN=
# Only needed if you host the precomputed cut on a PRIVATE OSF component.
OSF_TOKEN=
