# --- secrets / local env ---
.env
# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.vscode

# --- reproduction outputs (regenerated, never committed) ---
figures_out/
outputs/
results/
logs/

